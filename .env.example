JACKETT_URL=http://localhost:9117
JACKETT_API_KEY=changeme
QBIT_HOST=http://localhost:8080
QBIT_USER=admin
QBIT_PASS=adminadmin
# Set both values to require login (session cookie) for the whole app.
AUTH_USERNAME=
AUTH_PASSWORD=
# Signs the session cookie. If left empty, a random key is generated on
# every process start, which logs everyone out on restart. Set a fixed
# value to persist sessions across restarts:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
MOVIES_LIBRARY_PATH=/library/movies
TV_LIBRARY_PATH=/library/tv
DB_PATH=skald.db
